# ==========================================================================
# hier.ys  —  Conway's Game of Life: introduce /yy[*]/xx[*] module hierarchy
#
# TL-Verilog source:  life/life.tlv
# SandPiper SV output: life/life.sv
#
# TL-Verilog hierarchy being modularized:
#   /board_y[0:0]/board_x[0:0]/life|default/yy[9:0]/xx[9:0]
#
#   The innermost two replicated scopes form a 10×10 grid.
#   Each (yy, xx) cell is a separate replicated scope in TLV.
#   SandPiper emits them as:
#     L3_Life_DEFAULT_Yy[yy] / L4_Xx[xx]   generate-for loops
#
# Strategy
# --------
#   1. Flatten the design (proc + flatten).
#   2. For each (yy,xx) pair, collect the fan-in cone of the cell's
#      key signal (L3_Life_DEFAULT_Yy_Xx_alive_a1[yy][xx]) via submod.
#   3. Each (yy,xx) cell becomes module  life_cell_<yy>_<xx>.
#
# This is the annotated manual script; the automated version is:
#     python3 tlv_hier.py life
# ==========================================================================

# ---- Step 1: Read the design -------------------------------------------------
read_verilog -sv life.sv
hierarchy -top top -blackbox
proc
flatten
splitnets

# Mark the per-cell alive signals so opt_clean won't remove them.
setattr -set keep 1 w:*L3_Life_DEFAULT_Yy*alive*
opt_clean

# ---- Step 2: Dump flat netlist for inspection --------------------------------
write_json flat.json

# ---- Step 3: Extract per-cell modules (run tlv_hier.py to fill in cells) ----
#  Example for (yy=0, xx=0):
#    select -set life_cell_0_0  c:<cell1>  c:<cell2> ...
#    submod -name life_cell_0_0 @life_cell_0_0

# ---- Step 4: Finalize --------------------------------------------------------
hierarchy -top top
write_verilog -noattr hier_out.v
write_json    hier_out.json

